{
  "name": "@shuvix/chat-ui",
  "version": "0.1.0",
  "description": "Reusable ShuviX chat frontend (React). Talks to any backend through the injected ChatApi contract; ships ChatEvent/ChatMessage types via @shuvix/chat-protocol.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./api": "./src/api/chatApi.ts"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@codemirror/commands": "*",
    "@codemirror/lang-cpp": "*",
    "@codemirror/lang-css": "*",
    "@codemirror/lang-go": "*",
    "@codemirror/lang-html": "*",
    "@codemirror/lang-java": "*",
    "@codemirror/lang-javascript": "*",
    "@codemirror/lang-json": "*",
    "@codemirror/lang-php": "*",
    "@codemirror/lang-python": "*",
    "@codemirror/lang-rust": "*",
    "@codemirror/lang-sql": "*",
    "@codemirror/lang-xml": "*",
    "@codemirror/lang-yaml": "*",
    "@codemirror/language": "*",
    "@codemirror/legacy-modes": "*",
    "@codemirror/search": "*",
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@lezer/highlight": "*",
    "@shuvix/chat-protocol": "*"
  }
}
