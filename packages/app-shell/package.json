{
  "name": "@shuvix/app-shell",
  "version": "0.1.0",
  "description": "Reusable ShuviX app shell — sidebar (session list) + injectable settings container (tabs) + shared theme tokens. Host-agnostic, prop-driven; consumed by the Electron desktop and the Chrome extension.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./themes.css": "./src/themes.css",
    "./base.css": "./src/base.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "@shuvix/atomic-editor": "*",
    "@shuvix/chat-protocol": "*",
    "@shuvix/chat-ui": "*",
    "react": "*",
    "react-dom": "*",
    "react-i18next": "*"
  },
  "dependencies": {
    "@codemirror/state": "*",
    "@codemirror/view": "*",
    "@dnd-kit/core": "*",
    "@dnd-kit/sortable": "*",
    "@dnd-kit/utilities": "*",
    "@pierre/trees": "*",
    "docx-preview": "*",
    "fflate": "*",
    "foliate-js": "*",
    "lucide-react": "*",
    "react-markdown": "*",
    "rehype-highlight": "*",
    "rehype-raw": "*",
    "remark-gfm": "*",
    "uuid": "*",
    "xlsx": "*",
    "yaml": "*"
  }
}
