{
  "name": "shuvix-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "ShuviX monorepo — desktop app (apps/desktop) + reusable chat packages (packages/*).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.8.1",
    "rollup": "4.62.2"
  },
  "devDependencies": {
    "eslint-plugin-react-hooks": "7.0.1",
    "prettier": "3.8.1"
  },
  "scripts": {
    "dev": "npm run dev -w shuvix",
    "build": "npm run build -w shuvix",
    "dev:ext": "npm run dev -w @shuvix/extension",
    "build:ext": "npm run build -w @shuvix/extension",
    "typecheck:ext": "npm run typecheck -w @shuvix/extension",
    "typecheck": "npm run typecheck -w shuvix && npm run typecheck:ext",
    "lint": "npm run lint -w shuvix && eslint packages",
    "test": "npm run test -w shuvix",
    "format": "prettier --write .",
    "postinstall": "node -e \"process.env.CI||require('child_process').execSync('electron-rebuild -f -w better-sqlite3,node-pty',{stdio:'inherit'})\"",
    "build:mac": "npm run build:mac -w shuvix",
    "build:win": "npm run build:win -w shuvix",
    "build:linux": "npm run build:linux -w shuvix",
    "test:e2e": "npm run test:e2e -w shuvix",
    "test:e2e:chat": "npm run test:e2e:chat -w shuvix",
    "test:e2e:agents": "npm run test:e2e:agents -w shuvix",
    "test:e2e:policies": "npm run test:e2e:policies -w shuvix",
    "test:e2e:settings": "npm run test:e2e:settings -w shuvix",
    "test:e2e:notebook": "npm run test:e2e:notebook -w shuvix",
    "test:e2e:workflows": "npm run test:e2e:workflows -w shuvix"
  }
}
