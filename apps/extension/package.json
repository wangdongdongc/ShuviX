{
  "name": "@shuvix/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ShuviX Chrome 扩展（MV3）—— 每个标签页右侧一个侧边栏临时会话，会话跑在 ShuviX 桌面端；扩展只是界面与标签页上的手（经原生消息连桌面）。",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "i18next": "^25.8.13",
    "lucide-react": "^0.564.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@shuvix/app-shell": "*",
    "@shuvix/chat-protocol": "*",
    "@shuvix/chat-ui": "*",
    "@tailwindcss/vite": "^4.1.18",
    "@types/chrome": "^0.0.287",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.2.6"
  }
}
