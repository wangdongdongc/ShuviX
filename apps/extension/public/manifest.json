{
  "manifest_version": 3,
  "key": "",
  "name": "__MSG_appName__",
  "version": "0.1.0",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "minimum_chrome_version": "116",
  "icons": {
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "128": "icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "permissions": [
    "sidePanel",
    "nativeMessaging",
    "tabs",
    "tabGroups",
    "scripting",
    "debugger",
    "storage",
    "alarms"
  ],
  "host_permissions": ["<all_urls>"]
}
