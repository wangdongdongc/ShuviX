{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../../packages/chat-protocol/src/**/*",
    "../../packages/chat-ui/src/**/*",
    "../../packages/app-shell/src/contextmenu/**/*",
    "../../packages/agent-runtime/src/browser/extractPage.ts"
  ],
  "exclude": ["../../packages/**/__tests__/**", "../../packages/**/*.test.ts"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shuvix/chat-protocol/*": ["../../packages/chat-protocol/src/*"],
      "@shuvix/chat-ui": ["../../packages/chat-ui/src/index.ts"],
      "@shuvix/chat-ui/*": ["../../packages/chat-ui/src/*"],
      "@shuvix/app-shell/*": ["../../packages/app-shell/src/*"],
      "@shuvix/agent-runtime/browser/extractPage": [
        "../../packages/agent-runtime/src/browser/extractPage.ts"
      ]
    }
  }
}
