{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../../packages/chat-protocol/src/**/*",
    "../../packages/chat-ui/src/**/*",
    "../../packages/agent-runtime/src/**/*",
    "../../packages/app-shell/src/**/*"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["chrome", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shuvix/chat-protocol/*": ["../../packages/chat-protocol/src/*"],
      "@shuvix/chat-ui": ["../../packages/chat-ui/src/index.ts"],
      "@shuvix/chat-ui/*": ["../../packages/chat-ui/src/*"],
      "@shuvix/agent-runtime": ["../../packages/agent-runtime/src/index.ts"],
      "@shuvix/app-shell": ["../../packages/app-shell/src/index.ts"],
      "@shuvix/app-shell/*": ["../../packages/app-shell/src/*"]
    }
  }
}
