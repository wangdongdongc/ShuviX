{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/webui/env.d.ts",
    "src/webui/**/*",
    "src/webui/**/*.tsx",
    "src/preload/*.d.ts",
    "src/main/types/**/*.ts",
    "src/main/dao/types/**/*.ts",
    "src/shared/**/*",
    "../../packages/chat-protocol/src/**/*",
    "../../packages/chat-ui/src/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shuvix/chat-protocol/*": [
        "../../packages/chat-protocol/src/*"
      ],
      "@shuvix/chat-ui": [
        "../../packages/chat-ui/src/index.ts"
      ],
      "@shuvix/chat-ui/*": [
        "../../packages/chat-ui/src/*"
      ]
    }
  }
}
