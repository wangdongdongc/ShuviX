{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/preload/*.d.ts",
    "src/main/types/**/*.ts",
    "src/main/dao/types/**/*.ts",
    "src/shared/**/*",
    "../../packages/chat-protocol/src/**/*",
    "../../packages/chat-ui/src/**/*",
    "../../packages/app-shell/src/**/*",
    "../../packages/atomic-editor/src/**/*"
  ],
  "exclude": ["../../packages/atomic-editor/src/**/__tests__/**"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@renderer/*": [
        "src/renderer/src/*"
      ],
      "@shuvix/chat-protocol/*": [
        "../../packages/chat-protocol/src/*"
      ],
      "@shuvix/chat-ui": [
        "../../packages/chat-ui/src/index.ts"
      ],
      "@shuvix/chat-ui/*": [
        "../../packages/chat-ui/src/*"
      ],
      "@shuvix/app-shell": [
        "../../packages/app-shell/src/index.ts"
      ],
      "@shuvix/app-shell/*": [
        "../../packages/app-shell/src/*"
      ],
      "@shuvix/atomic-editor": [
        "../../packages/atomic-editor/src/index.ts"
      ],
      "@shuvix/atomic-editor/code-languages": [
        "../../packages/atomic-editor/src/code-languages.ts"
      ]
    }
  }
}
