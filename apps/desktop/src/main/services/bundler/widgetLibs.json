{
  "$comment": [
    "Libraries a widget's screen may import, besides react, react-dom, react-router and shuvix/widget. Read by widgetLibs.ts and scripts/vendor-widget-libs.mjs.",
    "version: must equal what is installed (apps/desktop/package.json pins it; the vendor script refuses a mismatch).",
    "files: globs relative to the package that replace the default selection (package.json, license files, and every .js/.mjs/.cjs/.css outside test, docs, bin and examples folders). A glob starting with ! takes files back out.",
    "served: not bundled into widgets. The widget server serves the vendored files (JS minified when vendored) under /w/<id>/lib/<name>@<version>/, and the page's import map points each specifier (a key ending in / is a prefix) at its file or folder. A served file may only import what that map answers, so three's WebGPU and TSL files, and the addons that need libraries from elsewhere, are left out.",
    "exportTypes: devDependencies an exported Vite project adds when the widget imports the library.",
    "blocked: exact specifiers the bundler refuses, with the hint it gives.",
    "dependencyFiles: file globs for dependencies pulled in by the libraries (keys may end in *).",
    "skipDependencies: dependencies that no browser entry point imports (command-line tools, server renderers)."
  ],
  "libraries": {
    "lucide-react": { "version": "0.564.0", "files": ["dist/esm/**/*.js"] },
    "chart.js": {
      "version": "4.6.1",
      "files": ["dist/chart.js", "dist/helpers.js", "dist/chunks/*.js", "auto/*.js", "helpers/*.js"]
    },
    "uplot": { "version": "1.6.32" },
    "d3": {
      "version": "7.9.0",
      "files": ["src/**/*.js"],
      "exportTypes": { "@types/d3": "^7.4.3" }
    },
    "papaparse": { "version": "5.7.0", "exportTypes": { "@types/papaparse": "^5.5.2" } },
    "dayjs": { "version": "1.11.23" },
    "marked": { "version": "18.1.2" },
    "dompurify": { "version": "3.4.17" },
    "@dnd-kit/core": { "version": "6.3.1" },
    "@dnd-kit/sortable": { "version": "10.0.0" },
    "@dnd-kit/utilities": { "version": "3.2.2" },
    "@tanstack/react-virtual": { "version": "3.14.24" },
    "fuse.js": { "version": "7.5.0" },
    "diff": { "version": "8.0.4" },
    "qrcode": { "version": "1.5.4", "exportTypes": { "@types/qrcode": "^1.5.6" } },
    "yaml": { "version": "2.9.0" },
    "highlight.js": {
      "version": "11.11.1",
      "files": ["es/**/*.js", "lib/**/*.js"],
      "blocked": {
        "highlight.js": "Importing \"highlight.js\" bundles every language (about 1 MB). Import \"highlight.js/lib/core\" and register the languages you need from \"highlight.js/lib/languages/<name>\"."
      }
    },
    "three": {
      "version": "0.187.0",
      "files": [
        "build/three.module.js",
        "build/three.core.js",
        "examples/jsm/animation/*.js",
        "examples/jsm/capabilities/WebGL.js",
        "examples/jsm/controls/*.js",
        "examples/jsm/csm/*.js",
        "examples/jsm/curves/*.js",
        "examples/jsm/effects/*.js",
        "examples/jsm/environments/*.js",
        "examples/jsm/exporters/*.js",
        "examples/jsm/geometries/*.js",
        "examples/jsm/helpers/*.js",
        "examples/jsm/interactive/*.js",
        "examples/jsm/interaction/*.js",
        "examples/jsm/lighting/LightProbeGridWebGL.js",
        "examples/jsm/lights/*.js",
        "examples/jsm/lines/*.js",
        "examples/jsm/loaders/*.js",
        "examples/jsm/materials/*.js",
        "examples/jsm/math/*.js",
        "examples/jsm/misc/*.js",
        "examples/jsm/modifiers/*.js",
        "examples/jsm/objects/*.js",
        "examples/jsm/postprocessing/*.js",
        "examples/jsm/renderers/*.js",
        "examples/jsm/shaders/*.js",
        "examples/jsm/textures/*.js",
        "examples/jsm/utils/*.js",
        "examples/jsm/webxr/*.js",
        "examples/jsm/libs/meshopt_decoder.module.js",
        "examples/jsm/libs/mikktspace.module.js",
        "examples/jsm/libs/lil-gui.module.min.js",
        "examples/jsm/libs/stats.module.js",
        "examples/jsm/libs/tween.module.js",
        "!examples/jsm/csm/CSMShadowNode.js",
        "!examples/jsm/exporters/DRACOExporter.js",
        "!examples/jsm/helpers/LightProbeGridHelper.js",
        "!examples/jsm/helpers/LightProbeHelperGPU.js",
        "!examples/jsm/helpers/TextureHelperGPU.js",
        "!examples/jsm/lights/SunLightNode.js",
        "!examples/jsm/lights/SunShadowNode.js",
        "!examples/jsm/loaders/3DMLoader.js",
        "!examples/jsm/loaders/GLTFGaussianSplatLoaderExtension.js",
        "!examples/jsm/loaders/MaterialXLoader.js",
        "!examples/jsm/loaders/TTFLoader.js",
        "!examples/jsm/materials/LDrawConditionalLineNodeMaterial.js",
        "!examples/jsm/materials/WoodNodeMaterial.js",
        "!examples/jsm/misc/ProgressiveLightMapGPU.js",
        "!examples/jsm/modifiers/CurveModifierGPU.js",
        "!examples/jsm/objects/GaussianSplat.js",
        "!examples/jsm/objects/LensflareMesh.js",
        "!examples/jsm/objects/SkyMesh.js",
        "!examples/jsm/objects/Water2Mesh.js",
        "!examples/jsm/objects/WaterMesh.js",
        "!examples/jsm/utils/MeshletGeometryUtils.js",
        "!examples/jsm/utils/ShadowMapViewerGPU.js",
        "!examples/jsm/utils/WebGPUTextureUtils.js"
      ],
      "served": {
        "three": "build/three.module.js",
        "three/addons/": "examples/jsm/"
      },
      "exportTypes": { "@types/three": "^0.187.0" }
    }
  },
  "dependencyFiles": {
    "d3-*": ["src/**/*.js"]
  },
  "skipDependencies": ["commander", "iconv-lite", "rw", "pngjs", "yargs"]
}
