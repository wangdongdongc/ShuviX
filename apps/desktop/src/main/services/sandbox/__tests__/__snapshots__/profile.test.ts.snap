exports[`PR-1 golden > PR-1 夹具规格的 profile 与参数表 > profile 1`] = `
"(version 1)
(deny default)
(import "system.sb")
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow mach-task-name)
(allow sysctl-read)
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx") (regex #"^/dev/ttys[0-9]+$"))
(allow ipc-posix-sem)
(allow ipc-posix-shm*)
(allow file-map-executable)
(system-network)
(allow file-read*)
(deny file-read* (subpath (param "P0")))
(allow file-read-metadata (literal (param "P1")) (literal (param "P2")) (literal (param "P3")) (literal (param "P4")) (literal (param "P5")) (literal (param "P6")) (literal (param "P7")) (literal (param "P8")))
(allow file-read* (subpath (param "P9")) (subpath (param "P10")) (subpath (param "P11")) (subpath (param "P12")) (subpath (param "P13")) (subpath (param "P14")) (subpath (param "P15")) (subpath (param "P16")) (subpath (param "P17")) (literal (param "P18")))
(allow file-write* (subpath (param "P19")) (subpath (param "P20")) (subpath (param "P21")) (subpath (param "P22")) (subpath (param "P23")) (subpath (param "P24")))
(allow network-outbound (remote ip "*:*"))
(allow network-bind network-inbound (local ip "*:*"))
(allow network-outbound (remote unix-socket (path-literal (param "P25"))) (remote unix-socket (path-literal (param "P26"))))
(allow network-bind network-outbound (local unix-socket (subpath (param "P27"))) (remote unix-socket (subpath (param "P27"))) (local unix-socket (subpath (param "P28"))) (remote unix-socket (subpath (param "P28"))))
(deny lsopen)
(deny appleevent-send)
(deny job-creation)
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd") (global-name "com.apple.CoreServices.coreservicesd") (global-name "com.apple.coreservices.appleevents") (global-name "com.apple.lsd.mapdb") (global-name "com.apple.lsd.modifydb"))
"
`;
