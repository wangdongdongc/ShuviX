exports[`PR-1 golden > PR-1 夹具规格（一个写授权）的 profile 与参数表 > profile 1`] = `
"(version 1)
(deny default)
(import "system.sb")
(allow process-exec process-fork)
(allow signal (target same-sandbox))
(allow process-info* (target same-sandbox))
(allow mach-task-name)
(allow sysctl-read)
(allow pseudo-tty)
(allow file-read* file-write* file-ioctl (literal "/dev/ptmx") (regex #"^/dev/ttys[0-9]+$"))
(allow ipc-posix-sem)
(allow ipc-posix-shm*)
(allow file-map-executable)
(system-network)
(allow file-read*)
(deny file-read* (subpath (param "P0")) (subpath (param "P1")) (subpath (param "P2")) (subpath (param "P3")) (subpath (param "P4")) (subpath (param "P5")) (subpath (param "P6")) (subpath (param "P7")))
(allow file-write* (subpath (param "P8")) (subpath (param "P9")) (subpath (param "P10")) (subpath (param "P11")) (subpath (param "P12")) (subpath (param "P13")) (subpath (param "P14")) (subpath (param "P15")) (subpath (param "P16")) (subpath (param "P17")) (subpath (param "P18")) (subpath (param "P19")) (subpath (param "P20")) (subpath (param "P21")) (subpath (param "P22")) (subpath (param "P23")) (subpath (param "P24")) (subpath (param "P25")) (subpath (param "P26")) (subpath (param "P27")) (subpath (param "P28")) (subpath (param "P29")) (subpath (param "P30")) (subpath (param "P31")))
(deny file-write* (subpath (param "P32")) (subpath (param "P33")))
(allow file-write* (subpath (param "P34")))
(deny file-write* (subpath (param "P37")) (subpath (param "P38")) (subpath (param "P39")) (subpath (param "P40")) (subpath (param "P41")) (subpath (param "P42")) (subpath (param "P43")) (subpath (param "P44")) (subpath (param "P45")) (subpath (param "P46")) (subpath (param "P47")) (subpath (param "P48")) (subpath (param "P49")) (subpath (param "P50")) (subpath (param "P51")) (subpath (param "P52")) (subpath (param "P53")) (subpath (param "P54")) (subpath (param "P55")) (subpath (param "P56")) (subpath (param "P57")) (subpath (param "P58")) (subpath (param "P59")) (subpath (param "P60")) (regex #"^/private/tmp/com\\.apple\\.launchd\\.") (require-all (subpath (param "P35")) (regex #"/\\.[Gg][Ii][Tt]/([Hh][Oo][Oo][Kk][Ss](/|$)|[Cc][Oo][Nn][Ff][Ii][Gg]$|[Cc][Oo][Nn][Ff][Ii][Gg]\\.[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee]$|[Cc][Oo][Mm][Mm][Oo][Nn][Dd][Ii][Rr]$)")) (require-all (subpath (param "P35")) (regex #"/\\.[Gg][Ii][Tt]/([Mm][Oo][Dd][Uu][Ll][Ee][Ss]|[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee][Ss])/.*/([Hh][Oo][Oo][Kk][Ss](/|$)|[Cc][Oo][Nn][Ff][Ii][Gg]$|[Cc][Oo][Nn][Ff][Ii][Gg]\\.[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee]$|[Cc][Oo][Mm][Mm][Oo][Nn][Dd][Ii][Rr]$)")) (require-all (subpath (param "P36")) (regex #"/\\.[Gg][Ii][Tt]/([Hh][Oo][Oo][Kk][Ss](/|$)|[Cc][Oo][Nn][Ff][Ii][Gg]$|[Cc][Oo][Nn][Ff][Ii][Gg]\\.[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee]$|[Cc][Oo][Mm][Mm][Oo][Nn][Dd][Ii][Rr]$)")) (require-all (subpath (param "P36")) (regex #"/\\.[Gg][Ii][Tt]/([Mm][Oo][Dd][Uu][Ll][Ee][Ss]|[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee][Ss])/.*/([Hh][Oo][Oo][Kk][Ss](/|$)|[Cc][Oo][Nn][Ff][Ii][Gg]$|[Cc][Oo][Nn][Ff][Ii][Gg]\\.[Ww][Oo][Rr][Kk][Tt][Rr][Ee][Ee]$|[Cc][Oo][Mm][Mm][Oo][Nn][Dd][Ii][Rr]$)")))
(deny file-write-create file-write-unlink (require-all (subpath (param "P61")) (regex #"/\\.[Gg][Ii][Tt]$")) (require-all (subpath (param "P62")) (regex #"/\\.[Gg][Ii][Tt]$")))
(allow network-outbound (remote ip "*:*"))
(allow network-bind network-inbound (local ip "*:*"))
(allow network-outbound (remote unix-socket (path-literal (param "P63"))) (remote unix-socket (path-literal (param "P64"))))
(allow network-bind network-outbound (local unix-socket (subpath (param "P65"))) (remote unix-socket (subpath (param "P65"))) (local unix-socket (subpath (param "P66"))) (remote unix-socket (subpath (param "P66"))))
(deny lsopen)
(deny appleevent-send)
(deny job-creation)
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd") (global-name "com.apple.CoreServices.coreservicesd") (global-name "com.apple.coreservices.appleevents") (global-name "com.apple.lsd.mapdb") (global-name "com.apple.lsd.modifydb"))
"
`;
